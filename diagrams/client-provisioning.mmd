flowchart TB
  plan["Inspect existing hosting and DNS"] --> manifest["Prepare exact mutation plan"]
  manifest --> approve{"Effects authorized?"}
  approve -->|"no"| stop["Keep the plan; make no changes"]
  approve -->|"yes: explicit execute run"| first["S3 bucket + versioning<br/>ACM + DNS validation"]
  first --> issued{"Certificate issued?"}
  issued -->|"pending"| wait["Stop; re-run after validation<br/>Existing resources are detected"]
  wait --> plan
  issued -->|"yes"| edge["CloudFront Function + OAC + distribution<br/>Scoped S3 bucket policy"]
  edge --> dns["Create site DNS records<br/>Report existing conflicts"]
  dns --> monitor["Route 53 health check<br/>CloudWatch alarm to SNS"]
  monitor --> record["Record resource and Terraform import maps"]
  record --> site["Client repository + content contract<br/>Site-specific build/deploy workflow"]
  site --> verify["Verify preview, public site,<br/>owner access and monitoring"]

  classDef decision fill:#fff7ed,stroke:#c2410c,color:#172b35
  classDef done fill:#ecfdf5,stroke:#047857,color:#172b35
  class approve,issued decision
  class stop,verify done
