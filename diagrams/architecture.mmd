  visitors(["Visitors · clients · prospects"])

  subgraph EDGE["Edge — Cloudflare + CloudFront"]
    direction LR
    cfdns["Cloudflare DNS<br/>DNS-only CNAMEs, DNSSEC,<br/>email routing"]:::edge
    cf["CloudFront ×10<br/>PriceClass_100 · ACM TLS<br/>CloudFront Functions:<br/>canonical URLs + bot block"]:::aws
  end

  subgraph STATIC["Static surfaces — S3 origins (OAC)"]
    direction LR
    mkt["raizhost.com<br/>Astro marketing site"]:::aws
    demos["demos.raizhost.com<br/>demo factory"]:::aws
    sites["Hosted client sites<br/>(the product)"]:::aws
    status["status.raizhost.com"]:::aws
  end

  subgraph APPS["Dynamic apps — scale-to-zero"]
    direction LR
    apigw["HTTP API Gateway ×9<br/>CORS + stage throttling"]:::aws
    lambdas["Lambda ×17 · arm64<br/>container web apps (Next.js + Web Adapter)<br/>Go/Rust zip APIs · Node pollers"]:::aws
    llm["llm.raizhost.com<br/>LLM Tracker"]:::aws
    quotes["quotes + sales-crm APIs"]:::aws
  end

  subgraph ANCHOR["The anchor — one always-on box"]
    direction LR
    ec2["EC2 t4g.medium (Graviton)<br/>Postgres + PgBouncer + Redis<br/>NAT for in-VPC Lambdas<br/>app.raizhost.com editor container"]:::aws
  end

  subgraph DATA["Data & state"]
    direction LR
    ddb[("DynamoDB ×2<br/>on-demand · PITR")]:::data
    s3["S3 ×15<br/>sites · assets · backups<br/>tfstate · signed contracts"]:::data
    secrets["Secrets Manager"]:::data
  end

  subgraph OPS["Operate — CI/CD, scheduling, observability"]
    direction LR
    gha["GitHub Actions workflows<br/>CodeBuild ephemeral runner: app<br/>repo-scoped OIDC deploy roles"]:::ops
    ecr["ECR ×7<br/>keep-last-5"]:::ops
    ssm["SSM Session Manager<br/>+ RunCommand deploys<br/>(no open SSH)"]:::ops
    sched["EventBridge Scheduler ×11<br/>pollers · crons ·<br/>opsbox stop/start"]:::ops
    cw["CloudWatch alarms<br/>Route 53 health checks<br/>→ SNS email"]:::ops
    tf["Terraform core + CloudFormation runners<br/>gated provisioning scripts<br/>Terraform CI static-only while drift is open"]:::ops
  end

  subgraph SAAS["External services"]
    direction LR
    stripe["Stripe<br/>subscriptions + payment links"]:::saas
    signwell["SignWell<br/>e-signature"]:::saas
    resend["Resend<br/>transactional email"]:::saas
  end

