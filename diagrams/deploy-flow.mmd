flowchart TB
  marketing["Marketing<br/>Approved manual dispatch<br/>Exact commit SHA"]
  portal["Portal<br/>Successful push CI on main<br/>Exact CI head SHA"]
  tracker["LLM Tracker<br/>Successful CI on main<br/>or manual dispatch"]
  client["Client site<br/>Content or code commit<br/>Live / preview branch"]

  marketing --> mjob["GitHub Actions + scoped OIDC<br/>Build Astro and run checks"]
  mjob --> ms3["S3 assets, then HTML<br/>Request invalidation; cleanup"]

  portal --> pjob["CodeBuild Actions + scoped OIDC<br/>CI builds ARM64 ECR image"]
  pjob --> ssm["SSM on anchor<br/>Reviewed script + additive migrations"]
  ssm --> health{"Container health"}
  health -->|"pass"| live["Record successful image"]
  health -->|"fail"| rollback["Restore prior image<br/>Verify rollback health"]

  tracker --> tjob["GitHub Actions + scoped OIDC<br/>Build web image + poller ZIP"]
  tjob --> web["Upload S3 bundles first<br/>Update web Lambda"]
  web --> workers["Update all three pollers<br/>Invoke and check each tier"]
  workers --> verify["Wait for CDN invalidation<br/>Check live data and RSS"]

  client --> cjob["Client repository workflow + OIDC<br/>Build the site"]
  cjob --> target["S3 public root or preview prefix<br/>CloudFront invalidation"]
  target --> status["Portal checks exact commit's run<br/>Confirm live only on success"]

  classDef start fill:#fff7ed,stroke:#c2410c,color:#172b35
  classDef finish fill:#ecfdf5,stroke:#047857,color:#172b35
  class marketing,portal,tracker,client start
  class ms3,live,verify,status finish
