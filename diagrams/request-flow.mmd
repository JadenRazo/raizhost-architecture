flowchart TB
  browser["Browser"]
  dns["Cloudflare DNS<br/>Name resolution only"]
  browser -. "resolve hostname" .-> dns
  browser -->|"HTTPS"| cf["CloudFront<br/>Separate distribution per surface"]
  browser -->|"quote / CRM API origin"| qapi["Separate HTTP APIs"]
  qapi --> qfn["Quote / CRM Lambdas"]
  qfn --> ddb[("Separate DynamoDB tables")]

  cf -->|"website / demo / client files"| sites["Private S3 site origins<br/>OAC"]
  cf -->|"app.raizhost.com"| portal["Next.js portal<br/>Docker on anchor"]
  portal --> editorDb[("Portal Postgres database")]
  cf -->|"llm pages, cache miss"| api["HTTP API Gateway"]
  api --> web["Next.js web Lambda"]
  web --> pool["PgBouncer on anchor"]
  pool --> trackerDb[("Tracker Postgres database")]
  cf -->|"llm /_next/static/*"| assets["Private S3 bundles<br/>OAC"]

  classDef edge fill:#fff7ed,stroke:#c2410c,color:#172b35
  classDef data fill:#ecfdf5,stroke:#047857,color:#172b35
  class dns,cf edge
  class sites,assets,ddb,editorDb,trackerDb data
